{
  "name": "@reifydb/reifydb",
  "version": "0.9.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "napi": {
    "binaryName": "reifydb"
  },
  "scripts": {
    "prebuild": "napi build --platform --release --manifest-path ../../rust/reifydb-node/Cargo.toml -o native",
    "build": "tsup src/index.ts --dts --format cjs --sourcemap --external ../native",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "publish:npm": "pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "@reifydb/client": "workspace:*",
    "@reifydb/core": "workspace:*",
    "@reifydb/store": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6",
    "@types/node": "^24.0.10",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "keywords": [
    "reifydb",
    "database",
    "native",
    "napi",
    "typescript"
  ],
  "files": [
    "dist/",
    "native/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reifydb/reifydb.git",
    "directory": "pkg/typescript/reifydb"
  },
  "homepage": "https://github.com/reifydb/reifydb#readme",
  "bugs": {
    "url": "https://github.com/reifydb/reifydb/issues"
  }
}
