CREATE MIGRATION 'uptime_create_status_page' {
    create procedure uptime::create_status_page { id: uuid7, slug: utf8, title: utf8 } as {
        assert { text::length(text::trim($title)) > 0 and text::length(text::trim($title)) <= 200 }
            "title must be between 1 and 200 characters";
        assert { text::length($slug) > 0 and text::length($slug) <= 64 } "slug must be between 1 and 64 characters";
        let $rest = $slug;
        while text::count($rest) > 0 {
            assert { text::contains("abcdefghijklmnopqrstuvwxyz0123456789-", text::substring($rest, 0, 1)) }
                "slug must contain only lowercase letters, digits, and hyphens";
            $rest = text::substring($rest, 1, 64)
        };
        assert { not text::starts_with($slug, "-") } "slug must not start with a hyphen";
        let $taken = from uptime::status_pages filter { slug == $slug and owner == $identity.id }
            map { id, slug };
        assert { is::none($taken.id) } "this slug is already taken";
        insert uptime::status_pages [{ id: $id, owner: $identity.id, slug: $slug,
            title: text::trim($title), created_at: datetime::now() }] returning { id }
    };
    create procedure policy uptime_call_create_status_page on uptime::create_status_page {
        call: { filter { $identity.kind == "user" or $identity.kind == "guest" } }
    }
};
