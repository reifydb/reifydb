(admin 'create namespace app')
(admin 'create table app::requests { service: utf8, latency: duration, queue: duration, ts: datetime } with { time: event(ts) }')
(admin 'create deferred view app::latency_1m { service: utf8, start: datetime, lat: digest(duration, 0.01) } as { from app::requests | window tumbling { start: window::start(), lat: stats::digest(latency, 0.01) } with { duration: 1m } by { service } }')
(admin 'create deferred view app::latency_1m_late { service: utf8, start: datetime, lat: digest(duration, 0.01) } as { from app::requests | window tumbling { start: window::start(), lat: stats::digest(latency, 0.01) } with { duration: 1m, lateness: 1h } by { service } }')
