> |     3     |    api    |  2026-01-01T00:01:00.000000000Z  |  digest(n: 40)  |
> |     2     |   auth    |  2026-01-01T00:00:00.000000000Z  |  digest(n: 3)   |
> |     1     |    api    |  2026-01-01T00:00:00.000000000Z  |  digest(n: 40)  |
> +-----------+-----------+----------------------------------+-----------------+
>

query 'from app::latency_1m | map { service, start, p999: stats::approx_percentile(lat, 0.999) }'
---
> +-----------+-----------+----------------------------------+-------------------+
> |  #rownum  |  service  |              start               |       p999        |
> +-----------+-----------+----------------------------------+-------------------+
> |     6     |   auth    |  2026-01-01T00:02:00.000000000Z  |  401ms456us752ns  |
> |     5     |    api    |  2026-01-01T00:02:00.000000000Z  |  746ms294us639ns  |
> |     4     |   auth    |  2026-01-01T00:01:00.000000000Z  |   29ms815us45ns   |
> |     3     |    api    |  2026-01-01T00:01:00.000000000Z  |  89ms572us630ns   |
> |     2     |   auth    |  2026-01-01T00:00:00.000000000Z  |   7ms63us673ns    |
> |     1     |    api    |  2026-01-01T00:00:00.000000000Z  |  49ms157us519ns   |
> +-----------+-----------+----------------------------------+-------------------+
>

query 'from app::latency_1m | aggregate { p99: stats::approx_percentile(lat, 0.99) } by { service }'
---
> +-----------+-------------------+
> |  service  |        p99        |
> +-----------+-------------------+
> |   auth    |  401ms456us752ns  |
> |    api    |  598ms911us84ns   |
> +-----------+-------------------+
>

(admin 'create table app::latency_daily { service: utf8, day: date, lat: digest(duration, 0.01) }')
command 'LET $daily = from app::latency_1m | map { service, day: datetime::date(start), lat } | aggregate { lat: stats::digest(lat) } by { service, day }; INSERT app::latency_daily $daily'
query 'from app::latency_daily | map { service, day, lat, p50: stats::approx_percentile(lat, 0.5), p99: stats::approx_percentile(lat, 0.99), p999: stats::approx_percentile(lat, 0.999) }'
---
> +-------------+-----------------+------------+
> |  namespace  |      table      |  inserted  |
> +-------------+-----------------+------------+
> |     app     |  latency_daily  |     2      |
> +-------------+-----------------+------------+
>
> +-----------+-----------+--------------+------------------+-----------------+-------------------+-------------------+
> |  #rownum  |  service  |     day      |       lat        |       p50       |        p99        |       p999        |
> +-----------+-----------+--------------+------------------+-----------------+-------------------+-------------------+
> |     2     |    api    |  2026-01-01  |  digest(n: 101)  |  60ms41us529ns  |  598ms911us84ns   |  746ms294us639ns  |
> |     1     |   auth    |  2026-01-01  |   digest(n: 9)   |  29ms815us45ns  |  401ms456us752ns  |  401ms456us752ns  |
> +-----------+-----------+--------------+------------------+-----------------+-------------------+-------------------+
>

# a sealed window drops late retractions, so only rows of the open 00:02 window change
command 'UPDATE app::requests { latency: 20ms } FILTER { service == "api" and latency == 750ms }'
command 'DELETE app::requests FILTER { service == "auth" and latency >= 100ms }'
await
query 'from app::latency_1m | map { service, start, p999: stats::approx_percentile(lat, 0.999) }'
