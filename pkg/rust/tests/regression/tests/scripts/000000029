# lateness 1h keeps the 00:00 and 00:01 windows open, so a delete there must reach the view
command 'DELETE app::requests FILTER { (service == "api" and latency == 49ms) or (service == "auth" and latency == 30ms) }'
await
query 'from app::latency_1m_late | map { service, start, p999: stats::approx_percentile(lat, 0.999) }'
query 'from app::latency_1m_late | aggregate { p99: stats::approx_percentile(lat, 0.99) } by { service }'
