# Test: == != and not == with a decimal param

admin 'DROP NAMESPACE IF EXISTS cmp_decimal CASCADE; CREATE NAMESPACE cmp_decimal; CREATE TABLE cmp_decimal::o { id: int4, v: Option(decimal) }; INSERT cmp_decimal::o [{ id: 1, v: "1.5" }, { id: 2, v: "-0.25" }, { id: 3, v: "12345678901234567890.123456789" }, { id: 9, v: none }]; OUTPUT FROM cmp_decimal::o SORT { id: asc }'
query_named 'FROM cmp_decimal::o FILTER { v == $p } SORT { id: asc }' 'p=-0.25::decimal'
query_named 'FROM cmp_decimal::o FILTER { v != $p } SORT { id: asc }' 'p=-0.25::decimal'
query_named 'FROM cmp_decimal::o FILTER { not (v == $p) } SORT { id: asc }' 'p=-0.25::decimal'
