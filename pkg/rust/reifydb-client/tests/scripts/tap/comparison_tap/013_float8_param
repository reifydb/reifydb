# Test: == != and not == with a float8 param

admin 'DROP NAMESPACE IF EXISTS cmp_float8 CASCADE; CREATE NAMESPACE cmp_float8; CREATE TABLE cmp_float8::o { id: int4, v: Option(float8) }; INSERT cmp_float8::o [{ id: 1, v: 0.5 }, { id: 2, v: -0.0 }, { id: 3, v: 0.000000000001 }, { id: 9, v: none }]; OUTPUT FROM cmp_float8::o SORT { id: asc }'
query_named 'FROM cmp_float8::o FILTER { v == $p } SORT { id: asc }' 'p=-0.0::float8'
query_named 'FROM cmp_float8::o FILTER { v != $p } SORT { id: asc }' 'p=-0.0::float8'
query_named 'FROM cmp_float8::o FILTER { not (v == $p) } SORT { id: asc }' 'p=-0.0::float8'
