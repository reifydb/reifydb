# Test: == != and not == with a float4 param

admin 'DROP NAMESPACE IF EXISTS cmp_float4 CASCADE; CREATE NAMESPACE cmp_float4; CREATE TABLE cmp_float4::o { id: int4, v: Option(float4) }; INSERT cmp_float4::o [{ id: 1, v: 0.5 }, { id: 2, v: -0.0 }, { id: 3, v: 1.5 }, { id: 9, v: none }]; OUTPUT FROM cmp_float4::o SORT { id: asc }'
query_named 'FROM cmp_float4::o FILTER { v == $p } SORT { id: asc }' 'p=-0.0::float4'
query_named 'FROM cmp_float4::o FILTER { v != $p } SORT { id: asc }' 'p=-0.0::float4'
query_named 'FROM cmp_float4::o FILTER { not (v == $p) } SORT { id: asc }' 'p=-0.0::float4'
