query_named 'FROM cmp_uint4::o FILTER { v == $p } SORT { id: asc }' 'p=1::uint4'
query_named 'FROM cmp_uint4::o FILTER { v != $p } SORT { id: asc }' 'p=1::uint4'
query_named 'FROM cmp_uint4::o FILTER { not (v == $p) } SORT { id: asc }' 'p=1::uint4'
