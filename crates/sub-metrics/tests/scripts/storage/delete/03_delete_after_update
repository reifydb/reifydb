# Tests delete after multiple updates.
# Historical accumulates every superseded version; the tombstone stays as the current version.

# Insert initial value
set a=1
---
ok

stats
---
current_count: 1
current_key_bytes: 11
current_value_bytes: 1
historical_count: 0
historical_key_bytes: 0
historical_value_bytes: 0
cdc_count: 0
cdc_key_bytes: 0
cdc_value_bytes: 0
total_bytes: 12

# First update - adds to historical
set a=2
---
ok

stats_historical
---
historical_count: 1
historical_key_bytes: 11
historical_value_bytes: 1

# Second update - adds to historical
set a=3
---
ok

stats_historical
---
historical_count: 2
historical_key_bytes: 22
historical_value_bytes: 2

# Delete - moves the live row to historical and leaves a tombstone as the current version
remove a
---
ok

# Current holds the tombstone: versioned key bytes, no value
stats_current
---
current_count: 1
current_key_bytes: 11
current_value_bytes: 0

# Historical should have:
# - Version 1: versioned_key=11, value=1 (from first update)
# - Version 2: versioned_key=11, value=1 (from second update)
# - Version 3: versioned_key=11, value=1 (from delete moving current to historical)
stats_historical
---
historical_count: 3
historical_key_bytes: 33
historical_value_bytes: 3
