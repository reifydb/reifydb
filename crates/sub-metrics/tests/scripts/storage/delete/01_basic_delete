# Tests basic delete tracking.
# Delete moves the pre-image to historical and leaves a tombstone as the key's current version.

# Insert a key
set a=1
---
ok

stats_current
---
current_count: 1
current_key_bytes: 11
current_value_bytes: 1

stats_historical
---
historical_count: 0
historical_key_bytes: 0
historical_value_bytes: 0

# Delete the key
remove a
---
ok

# The tombstone is the key's current version, so current still holds one entry. Key "a" is
# 1 byte plus the 10-byte MVCC version suffix, and a tombstone carries no value.
stats_current
---
current_count: 1
current_key_bytes: 11
current_value_bytes: 0

# Historical should have only the displaced pre-image: versioned_key=11, value=1
stats_historical
---
historical_count: 1
historical_key_bytes: 11
historical_value_bytes: 1
