# Complex sequence of mixed operations.
# Verifies stats remain consistent throughout.

# Phase 1: Multiple inserts
set a=1
---
ok

set b=2
---
ok

set c=3
---
ok

stats_totals
---
total_count: 3
current_bytes: 36
historical_bytes: 0
total_bytes: 36

# Phase 2: Updates
set a=11
---
ok

set b=22
---
ok

stats_totals
---
total_count: 5
current_bytes: 38
historical_bytes: 24
total_bytes: 62

# Phase 3: Delete
remove c
---
ok

stats_totals
---
total_count: 6
current_bytes: 26
historical_bytes: 47
total_bytes: 73

# Phase 4: More updates on remaining keys
set a=111
---
ok

set b=222
---
ok

stats_totals
---
total_count: 8
current_bytes: 28
historical_bytes: 73
total_bytes: 101

# Phase 5: Remove key a. Nothing is erased: the live v7 row migrates into historical and a
# tombstone is appended, so historical gains two entries while a leaves the current bucket.
# total_bytes is unchanged because the row's bytes moved between buckets rather than being
# freed; reclaiming them is the reaper's job, not the commit's.
remove_silent a version=10
---
ok

stats_totals
---
total_count: 9
current_bytes: 14
historical_bytes: 98
total_bytes: 112

# Phase 6: Final insert
set d=4
---
ok

stats_totals
---
total_count: 10
current_bytes: 26
historical_bytes: 98
total_bytes: 124

# Final full stats check. Current holds the two live rows (b and d); historical holds every
# superseded version plus the two tombstones, neither of which carries a value.
stats
---
current_count: 2
current_key_bytes: 22
current_value_bytes: 4
historical_count: 8
historical_key_bytes: 88
historical_value_bytes: 10
cdc_count: 0
cdc_key_bytes: 0
cdc_value_bytes: 0
total_bytes: 124
