# Tests that saturating_sub prevents underflow.
# A removal is a tombstone, so removing an already-removed key decrements the current
# bucket a second time from an already-empty state. That is the underflow this guards.

# Create versions
set a=1 version=1
---
ok

set a=2 version=2
---
ok

set a=3 version=3
---
ok

# Two superseded versions moved current -> historical. Key "a" is 1 byte plus the
# 10-byte MVCC version suffix, so 11 key bytes each; values "1" and "2" are 1 byte each.
stats_historical
---
historical_count: 2
historical_key_bytes: 22
historical_value_bytes: 2

# Remove the key. This does not erase anything: the live v3 row migrates into historical
# and a tombstone is appended at v4, so historical gains two entries (the displaced row
# and the tombstone) while current empties out.
remove_silent a version=4
---
ok

stats
---
current_count: 0
current_key_bytes: 0
current_value_bytes: 0
historical_count: 4
historical_key_bytes: 44
historical_value_bytes: 3
cdc_count: 0
cdc_key_bytes: 0
cdc_value_bytes: 0
total_bytes: 47

# Removing an already-removed key must not underflow. Current is already empty, so the
# saturating decrements hold it at zero while historical gains the displaced tombstone
# and a new one. The displaced entry carries no value, so historical_value_bytes is flat.
remove_silent a version=5
---
ok

stats
---
current_count: 0
current_key_bytes: 0
current_value_bytes: 0
historical_count: 6
historical_key_bytes: 66
historical_value_bytes: 3
cdc_count: 0
cdc_key_bytes: 0
cdc_value_bytes: 0
total_bytes: 69

# A silent removal is invisible to CDC by construction, which is why every cdc_* counter
# above stayed at zero across both removals.
