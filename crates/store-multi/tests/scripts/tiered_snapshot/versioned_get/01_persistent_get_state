# Verifies storage classifies Value / NotFound in a single query (the non-lossy get).
# The persistent tier is terminal and materializes a delete by removing the row, so an
# absent key and a deleted key are the same answer here; the buffer, which still holds
# versions, is what distinguishes Tombstone.
#
# Coupled-flush model: a single watermark W=2 governs every sweep below. The first
# sweep persists the live v1 row; the second sweep (after the delete) removes it.

watermark 2
---
ok

# Absent key -> notfound, not tombstone
persistent_get_state k version=1
---
"k" => notfound

# Value written and swept into persistent at v1 (v1 <= W)
set k=alive version=1
flush
---
ok

persistent_get_state k version=1
---
"k" => "alive" version=1

# Visible from a later snapshot, still reported at its stored version
persistent_get_state k version=9
---
"k" => "alive" version=1

# Below the write the row is not yet visible -> notfound, never tombstone
persistent_get_state k version=0
---
"k" => notfound

# Delete at v2; sweep at W=2 removes the row rather than storing a valueless one
remove_with_pre k=alive version=2
flush
---
ok

# The row is gone, so an in-range delete reads as notfound
persistent_get_state k version=2
---
"k" => notfound

# Nothing survives the delete, so no earlier version is readable either
persistent_get_state k version=1
---
"k" => notfound
