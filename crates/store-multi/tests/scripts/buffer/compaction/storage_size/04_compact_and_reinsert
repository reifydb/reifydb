# Verify that size changes correctly on drop and reinsert

# Insert entry
set x=original
---
ok

# Storage has 1 entry
storage_size
---
size: 1

# Drop entry
compact x
---
ok

# Storage is empty
storage_size
---
size: 0

# Reinsert with new value
set x=new_value
---
ok

# Storage has 1 entry again
storage_size
---
size: 1

# Verify new value
get x
---
"x" => "new_value"

# Drop and reinsert multiple times
compact x
set x=value2
compact x
set x=value3
---
ok
ok
ok
ok

# Storage still has 1 entry
storage_size
---
size: 1

# Verify latest value
get x
---
"x" => "value3"
