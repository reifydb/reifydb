# Retention deletes whole blocks and never rewrites one, so a cutoff inside a block leaves it intact and
# reclaims nothing; a rewrite would invalidate a reader already holding the old payload.

write 1
write 2
write 3
flush
drop_before 2
blocks
bounds
---
dropped=0 sources=0 more=false
blocks=1 [1..3 n=3]
min=1 max=3 truncated_before=0

# Every record in the straddling block is still readable.

read 1
read 2
read 3
---
v1 => changes=1 ts=1700000000000000000
v2 => changes=1 ts=1700000000000000000
v3 => changes=1 ts=1700000000000000000

# A cutoff above the block's highest version drops it whole, and the floor advances past what it carried.

drop_before 4
blocks
bounds
---
dropped=3 sources=1 more=false
blocks=0
min=None max=None truncated_before=4

read 1
read 3
---
v1 => None
v3 => None
