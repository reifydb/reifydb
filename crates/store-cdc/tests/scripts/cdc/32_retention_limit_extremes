# The drop scan takes limit + 1 rows to learn whether more remain, so both ends of the usize range have to be
# safe: a zero budget must delete nothing at all, and an unbounded one must not overflow that addition.

write 1
flush
write 2
flush
write 3
flush
blocks
---
blocks=3 [1..1 n=1] [2..2 n=1] [3..3 n=1]

# A zero budget deletes nothing and leaves the floor where it was, so a caller that throttles retention to
# zero never loses the records it refused to pay for.

drop_before 3 limit=0
blocks
bounds
---
dropped=0 sources=0 more=true
blocks=3 [1..1 n=1] [2..2 n=1] [3..3 n=1]
min=1 max=3 truncated_before=0

# An unbounded budget takes every block below the cutoff in one pass.

drop_before 3 limit=18446744073709551615
blocks
bounds
---
dropped=2 sources=1 more=false
blocks=1 [3..3 n=1]
min=3 max=3 truncated_before=3

# With nothing left below the cutoff, both budgets agree the pass is finished.

drop_before 3 limit=0
drop_before 3 limit=18446744073709551615
---
dropped=0 sources=0 more=false
dropped=0 sources=0 more=false
