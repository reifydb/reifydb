# A bounded pass deletes at most `limit` blocks and says more remain, so a sweep never drains the tier in one
# unbounded delete.

write 1
flush
write 2
flush
write 3
flush
write 4
flush
blocks
---
blocks=4 [1..1 n=1] [2..2 n=1] [3..3 n=1] [4..4 n=1]

drop_before 4 limit=2
blocks
bounds
---
dropped=2 sources=1 more=true
blocks=2 [3..3 n=1] [4..4 n=1]
min=3 max=4 truncated_before=3

# The second pass finds only one block left below the cutoff and reports that nothing more remains.

drop_before 4 limit=2
blocks
bounds
---
dropped=1 sources=1 more=false
blocks=1 [4..4 n=1]
min=4 max=4 truncated_before=4

# The block at the cutoff is never a candidate, however many passes run.

drop_before 4 limit=2
blocks
---
dropped=0 sources=0 more=false
blocks=1 [4..4 n=1]
