join_expiries_by_time
---
count=0

join_expiry_set row=1 at=300
join_expiry_set row=2 at=100
join_expiry_set row=3 at=200
---
ok

# The scan is ordered by deadline, not by row number; sealing in the wrong order fires the wrong timers first.

join_expiries_by_time
---
0/2 => 100
0/3 => 200
0/1 => 300
count=3

flush
join_expiries_by_time
---
ok
0/2 => 100
0/3 => 200
0/1 => 300
count=3

# A re-armed join expiry must move in the order rather than keeping its durable position.

join_expiry_set row=1 at=50
join_expiries_by_time
---
0/1 => 50
0/2 => 100
0/3 => 200
count=3

# The limit takes the front of the order, not an arbitrary page.

join_expiries_by_time limit=2
---
0/1 => 50
0/2 => 100
count=2

flush
join_expiries_by_time limit=2
join_expiries_by_time
---
ok
0/1 => 50
0/2 => 100
count=2
0/1 => 50
0/2 => 100
0/3 => 200
count=3

# The scan stays inside its group and its operator.

join_expiries_by_time group=2
join_expiries_by_time op=2
---
count=0
count=0

join_expiry_set row=7 at=10 group=2
join_expiries_by_time group=2
join_expiries_by_time
---
0/7 => 10
count=1
0/1 => 50
0/2 => 100
0/3 => 200
count=3

flush
join_expiries_by_time group=2
join_expiries_by_time
---
ok
0/7 => 10
count=1
0/1 => 50
0/2 => 100
0/3 => 200
count=3
