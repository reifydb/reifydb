join_expiry_set row=1 at=100
join_expiry_set row=2 at=200 group=2
join_expiry_set row=3 at=300 op=2
set a=1
flush
---
ok

# The operator-wide drop covers every group the operator owns.

join_expiries_drop
join_expiries_by_time
join_expiries_by_time group=2
join_expiry_get row=1
join_expiry_get row=2 group=2
---
count=0
count=0
join_expiry 0/1 => None
join_expiry 0/2 => None

# It never touches operator state, and it never reaches a neighbouring operator.

get a
range
join_expiries_by_time op=2
---
"a" => "1"
"a" => "1"
has_more=false
0/3 => 300
count=1

# A join expiry armed after the drop must survive it.

join_expiry_set row=4 at=400
join_expiries_by_time
---
0/4 => 400
count=1

flush
join_expiries_by_time
join_expiries_by_time group=2
join_expiries_by_time op=2
join_expiry_get row=1
get a
---
ok
0/4 => 400
count=1
count=0
0/3 => 300
count=1
join_expiry 0/1 => None
"a" => "1"

# Dropping the join expiries of an operator that has none is a no-op.

join_expiries_drop op=3
flush
join_expiries_by_time
join_expiries_by_time op=2
---
ok
0/4 => 400
count=1
0/3 => 300
count=1
