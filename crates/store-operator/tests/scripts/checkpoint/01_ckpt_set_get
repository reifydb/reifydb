ckpt_get 7
---
flow 7 => None

# A checkpoint must be readable straight away; serving the older durable version replays work already committed.

ckpt_set 7 41
ckpt_get 7
---
flow 7 => 41

# A later checkpoint supersedes the earlier one rather than queueing behind it.

ckpt_set 7 42
ckpt_get 7
---
flow 7 => 42

flush
ckpt_get 7
---
ok
flow 7 => 42

# Flows are independent: one flow's checkpoint must never answer for another.

ckpt_set 8 5
ckpt_get 7
ckpt_get 8
ckpt_get 9
---
flow 7 => 42
flow 8 => 5
flow 9 => None

flush
ckpt_get 7
ckpt_get 8
ckpt_get 9
---
ok
flow 7 => 42
flow 8 => 5
flow 9 => None

# A checkpoint below the version the flow already holds is refused. The persistent tier stores whatever it is
# handed, so the store is the only place a rewind is caught; let through, it hands retention a floor it has
# already reaped past and the flow resumes into cdc entries that are gone. The held version stands and the
# refusal stages nothing.

ckpt_set 7 20
ckpt_get 7
---
error: flow 7 moved its checkpoint backwards
flow 7 => 42

flush
ckpt_get 7
---
ok
flow 7 => 42
