anchor_get row=1
---
anchor 0/1 => None

anchor_set row=1 at=100
anchor_get row=1
---
anchor 0/1 => 100

# Re-arming must replace the deadline, otherwise the seal fires against a superseded one.

anchor_set row=1 at=900
anchor_get row=1
---
anchor 0/1 => 900

flush
anchor_get row=1
---
ok
anchor 0/1 => 900

# The side and the group are part of the anchor identity, not decoration.

anchor_set row=1 at=200 side=1
anchor_set row=1 at=300 group=2
anchor_get row=1
anchor_get row=1 side=1
anchor_get row=1 group=2
---
anchor 0/1 => 900
anchor 1/1 => 200
anchor 0/1 => 300

flush
anchor_get row=1
anchor_get row=1 side=1
anchor_get row=1 group=2
---
ok
anchor 0/1 => 900
anchor 1/1 => 200
anchor 0/1 => 300

# So is the operator.

anchor_set row=1 at=400 op=2
anchor_get row=1
anchor_get row=1 op=2
---
anchor 0/1 => 900
anchor 0/1 => 400

flush
anchor_get row=1
anchor_get row=1 op=2
---
ok
anchor 0/1 => 900
anchor 0/1 => 400

# An expiry of zero is a real deadline, not an absent one.

anchor_set row=2 at=0
anchor_get row=2
---
anchor 0/2 => 0

flush
anchor_get row=2
---
ok
anchor 0/2 => 0
