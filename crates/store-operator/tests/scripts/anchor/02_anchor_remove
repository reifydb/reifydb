anchor_set row=1 at=100
anchor_set row=2 at=200
flush
---
ok

# A disarmed timer must stay disarmed; reading through to the durable row re-arms it.

anchor_remove row=1
anchor_get row=1
anchor_get row=2
anchors_by_expiry
---
anchor 0/1 => None
anchor 0/2 => 200
0/2 => 200
count=1

flush
anchor_get row=1
anchor_get row=2
anchors_by_expiry
---
ok
anchor 0/1 => None
anchor 0/2 => 200
0/2 => 200
count=1

# Removing an anchor that was never armed is a no-op.

anchor_remove row=9
anchor_get row=9
anchor_get row=2
---
anchor 0/9 => None
anchor 0/2 => 200

# The slot can be armed again after the removal.

anchor_set row=1 at=500
anchor_get row=1
anchors_by_expiry
---
anchor 0/1 => 500
0/2 => 200
0/1 => 500
count=2

flush
anchor_get row=1
anchors_by_expiry
---
ok
anchor 0/1 => 500
0/2 => 200
0/1 => 500
count=2

# A removal is scoped to its slot: the same row number on the other side survives.

anchor_set row=1 at=600 side=1
flush
anchor_remove row=1
anchor_get row=1
anchor_get row=1 side=1
---
ok
anchor 0/1 => None
anchor 1/1 => 600
