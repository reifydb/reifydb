anchor_set row=1 at=100
anchor_set row=2 at=200 group=2
set a=1
flush
---
ok

# The named group is emptied while its sibling keeps its timers; masking by operator alone would disarm every
# timer the operator owns.

anchors_group_remove
anchors_by_expiry
anchor_get row=1
anchors_by_expiry group=2
anchor_get row=2 group=2
---
count=0
anchor 0/1 => None
0/2 => 200
count=1
anchor 0/2 => 200

# An anchor drop must never touch operator state.

get a
range
---
"a" => "1"
"a" => "1"
has_more=false

# An anchor armed after the group removal must survive it, otherwise the group is left with no timer at all.

anchor_set row=3 at=300
anchors_by_expiry
anchor_get row=3
---
0/3 => 300
count=1
anchor 0/3 => 300

flush
anchors_by_expiry
anchors_by_expiry group=2
anchor_get row=1
anchor_get row=3
get a
---
ok
0/3 => 300
count=1
0/2 => 200
count=1
anchor 0/1 => None
anchor 0/3 => 300
"a" => "1"

# Removing a group that holds nothing is a no-op.

anchors_group_remove group=9
flush
anchors_by_expiry
anchors_by_expiry group=2
---
ok
0/3 => 300
count=1
0/2 => 200
count=1
