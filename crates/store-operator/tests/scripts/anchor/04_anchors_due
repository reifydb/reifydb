anchor_set row=1 at=100
anchor_set row=2 at=200
anchor_set row=3 at=300
---
ok

# Nothing is due before the earliest deadline.

anchors_due at=50
---
count=0

# The boundary is inclusive: an anchor due exactly now must fire now.

anchors_due at=100
---
0/1 => 100
count=1

anchors_due at=250
---
0/1 => 100
0/2 => 200
count=2

flush
anchors_due at=50
anchors_due at=100
anchors_due at=250
---
ok
count=0
0/1 => 100
count=1
0/1 => 100
0/2 => 200
count=2

anchors_due at=1000
---
0/1 => 100
0/2 => 200
0/3 => 300
count=3

# The limit pages the due set from the front of the order.

anchors_due at=1000 limit=2
---
0/1 => 100
0/2 => 200
count=2

# A removed anchor must never be served as due, otherwise the seal loop keeps firing a disarmed timer.

anchor_remove row=1
anchors_due at=1000
---
0/2 => 200
0/3 => 300
count=2

# A page sized to the limit must still fill itself when the earliest anchors are hidden by the buffer.

anchors_due at=1000 limit=2
---
0/2 => 200
0/3 => 300
count=2

flush
anchors_due at=1000
anchors_due at=1000 limit=2
---
ok
0/2 => 200
0/3 => 300
count=2
0/2 => 200
0/3 => 300
count=2

# A deadline brought forward becomes due earlier.

anchor_set row=3 at=150
anchors_due at=180
---
0/3 => 150
count=1

flush
anchors_due at=180
---
ok
0/3 => 150
count=1

# The due scan stays inside its group.

anchors_due at=1000 group=2
---
count=0
