# Every write variant must land through the batch entry point exactly as it would one at a time.

set c=old
batch set=a/1 set=b/2 remove=c
get a
get b
get c
---
"a" => "1"
"b" => "2"
"c" => None

flush
get a
get b
get c
---
ok
"a" => "1"
"b" => "2"
"c" => None

# Later writes in one batch win over earlier ones for the same key.

batch set=a/first set=a/second
get a
---
"a" => "second"

# The operator applies to the writes that follow it, so one batch can span operators.

batch op=2 set=a/9
get a
get a op=2
---
"a" => "second"
"a" => "9"

# Join expiries ride the same batch as state.

batch join_expiry_set=1/0/7/500 join_expiry_set=1/0/8/300
join_expiries_by_time
---
0/8 => 300
0/7 => 500
count=2

batch join_expiry_remove=1/0/8
join_expiries_by_time
join_expiry_get row=8
---
0/7 => 500
count=1
join_expiry 0/8 => None

flush
join_expiries_by_time
join_expiry_get row=7
get a
get a op=2
---
ok
0/7 => 500
count=1
join_expiry 0/7 => 500
"a" => "second"
"a" => "9"

# A batch that carries nothing must change nothing.

batch
get a
join_expiries_by_time
---
"a" => "second"
0/7 => 500
count=1
