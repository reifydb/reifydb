# A write lives only in the commit buffer until the flush; a synchronous sqlite write on the commit path is
# exactly what the buffer exists to remove.

set a=1
commit_get a
persistent_get a
get a
---
"a" => "1"
"a" => None
"a" => "1"

# The flush makes the row durable without dropping it. The entry stays resident as clean, so the buffer still
# answers for it and the layered read is served from memory.

flush
commit_get a
persistent_get a
get a
---
ok
"a" => "1"
"a" => "1"
"a" => "1"

# A key no layer has seen is unknown to the buffer, not a tombstone; a tombstone would stop the read.

commit_get zz
persistent_get zz
get zz
---
"zz" => unknown
"zz" => None
"zz" => None

# The second write of the same key sits in the buffer over the flushed one.

set a=2
commit_get a
persistent_get a
get a
---
"a" => "2"
"a" => "1"
"a" => "2"

flush
commit_get a
persistent_get a
get a
---
ok
"a" => "2"
"a" => "2"
"a" => "2"
