# Sizes are the logical row set, maintained from the write stream, so an unflushed write is visible at once;
# reading sqlite alone would report zero here and hide unbounded buffer growth from every size gauge.

set a=1
bytes
total_bytes
census
---
bytes 1 => 41
total_bytes => 41
operator 1 keyspace 0x1b keys=1 key_bytes=40 value_bytes=1
count=1

# Flushing makes the key durable without changing the logical row set, so the numbers must not move with it.

flush
bytes
total_bytes
census
---
ok
bytes 1 => 41
total_bytes => 41
operator 1 keyspace 0x1b keys=1 key_bytes=40 value_bytes=1
count=1

# An unflushed overwrite replaces the value of the one logical row. The durable pre-image sqlite still holds
# is not charged a second time, so neither the key count nor the key bytes move.

set a=111
bytes
census
---
bytes 1 => 43
operator 1 keyspace 0x1b keys=1 key_bytes=40 value_bytes=3
count=1

flush
bytes
census
---
ok
bytes 1 => 43
operator 1 keyspace 0x1b keys=1 key_bytes=40 value_bytes=3
count=1

# A removal frees the row at once, before the delete lands. The durable copy sqlite still holds is not
# charged, because the census counts the logical row set and not physical occupancy.

remove a
bytes
census
---
bytes 1 => 0
count=0

flush
bytes
census
---
ok
bytes 1 => 0
count=0
