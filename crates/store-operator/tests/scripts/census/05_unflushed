# Sizes are the footprint of sqlite plus the commit buffer, so an unflushed write is visible at once; reading
# sqlite alone would report zero here and hide unbounded buffer growth from every size gauge.

set a=1
bytes
total_bytes
census
---
bytes 1 => 34
total_bytes => 34
operator 1 keyspace 0x1c keys=1 key_bytes=33 value_bytes=1
count=1

# Flushing moves the same key from buffer to sqlite, so the numbers must not move with it.

flush
bytes
total_bytes
census
---
ok
bytes 1 => 34
total_bytes => 34
operator 1 keyspace 0x1c keys=1 key_bytes=33 value_bytes=1
count=1

# An unflushed join expiry is charged its flat 33 + 8 immediately.

join_expiry_set row=1 at=100
bytes
total_bytes
join_expiry_census
---
bytes 1 => 75
total_bytes => 75
operator 1 => 1
count=1

flush
bytes
join_expiry_census
---
ok
bytes 1 => 75
operator 1 => 1
count=1

# An unflushed overwrite is charged twice on purpose: the old value still occupies sqlite and the new one
# occupies RAM. The key count over-reports for exactly as long as both copies exist.

set a=111
bytes
census
---
bytes 1 => 111
operator 1 keyspace 0x1c keys=2 key_bytes=66 value_bytes=4
count=1

flush
bytes
census
---
ok
bytes 1 => 77
operator 1 keyspace 0x1c keys=1 key_bytes=33 value_bytes=3
count=1

# A removal frees nothing until it lands, because the durable copy is what is being measured.

remove a
bytes
census
---
bytes 1 => 77
operator 1 keyspace 0x1c keys=1 key_bytes=33 value_bytes=3
count=1

flush
bytes
census
---
ok
bytes 1 => 41
count=0
