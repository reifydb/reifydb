# Sizes are read from sqlite alone and therefore lag the commit buffer by up to one flush; every assertion
# below flushes first so what is measured is what is durable.

bytes
---
bytes 1 => 0

# A framed key is 16 group bytes plus 1 keyspace byte plus its suffix, and a row is its body alone: "a" costs
# 18 + 1.

set a=1
flush
bytes
---
ok
bytes 1 => 19

# "bb" costs 19 + 2.

set bb=22
flush
bytes
---
ok
bytes 1 => 40

# A join expiry is charged a flat 33 key bytes plus 8 value bytes.

join_expiry_set row=1 at=100
flush
bytes
---
ok
bytes 1 => 81

# A neighbouring operator is billed separately.

set z=9 op=2
flush
bytes
bytes op=2
---
ok
bytes 1 => 81
bytes 2 => 19

# A removed key stops being counted.

remove a
flush
bytes
---
ok
bytes 1 => 62

# A removed join expiry stops being counted too.

join_expiry_remove row=1
flush
bytes
---
ok
bytes 1 => 21

# An operator that owns nothing costs nothing.

bytes op=3
---
bytes 3 => 0
