# Sizes are read from sqlite alone and therefore lag the commit buffer by up to one flush; every assertion
# below flushes first so what is measured is what is durable.

bytes
---
bytes 1 => 0

# A stored key is 24 group bytes, the one keyspace byte that frames it, and its keyspace's fixed suffix
# width. A row is its body alone, so "a" costs 41 + 1.

set a=1
flush
bytes
---
ok
bytes 1 => 42

# "bb" costs the same 41 key bytes as "a", plus 2.

set bb=22
flush
bytes
---
ok
bytes 1 => 85

# A neighbouring operator is billed separately.

set z=9 op=2
flush
bytes
bytes op=2
---
ok
bytes 1 => 85
bytes 2 => 42

# A removed key stops being counted.

remove a
flush
bytes
---
ok
bytes 1 => 43

# An operator that owns nothing costs nothing.

bytes op=3
---
bytes 3 => 0
