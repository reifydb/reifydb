# Sizes are read from sqlite alone and therefore lag the commit buffer by up to one flush; every assertion
# below flushes first so what is measured is what is durable.

bytes
---
bytes 1 => 0

# A stored key is 24 group bytes plus its keyspace's fixed suffix width; the keyspace itself is the table it
# lands in and costs nothing per row. A row is its body alone, so "a" costs 40 + 1.

set a=1
flush
bytes
---
ok
bytes 1 => 41

# "bb" costs the same 40 key bytes as "a", plus 2.

set bb=22
flush
bytes
---
ok
bytes 1 => 83

# A neighbouring operator is billed separately.

set z=9 op=2
flush
bytes
bytes op=2
---
ok
bytes 1 => 83
bytes 2 => 41

# A removed key stops being counted.

remove a
flush
bytes
---
ok
bytes 1 => 42

# An operator that owns nothing costs nothing.

bytes op=3
---
bytes 3 => 0
