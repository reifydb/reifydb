census
---
count=0

# One bucket per operator and keyspace; a key costs 17 framing bytes plus its suffix and a row its body
# alone.

set a=1
flush
census
---
ok
operator 1 keyspace 0x2c keys=1 key_bytes=32 value_bytes=1
count=1

set bb=22
flush
census
---
ok
operator 1 keyspace 0x2c keys=2 key_bytes=64 value_bytes=3
count=1

# A second keyspace is a separate bucket. Keyspace bytes are stored inverted, so 0x2c sorts ahead of 0x1d.

set c=3 ks=0x1D
flush
census
---
ok
operator 1 keyspace 0x2c keys=2 key_bytes=64 value_bytes=3
operator 1 keyspace 0x1d keys=1 key_bytes=24 value_bytes=1
count=2

# An overwrite moves value bytes without changing the key count; counting it as a new key would inflate the
# bucket forever.

set a=111
flush
census
---
ok
operator 1 keyspace 0x2c keys=2 key_bytes=64 value_bytes=5
operator 1 keyspace 0x1d keys=1 key_bytes=24 value_bytes=1
count=2

# A neighbouring operator gets its own buckets.

set z=9 op=2
flush
census
---
ok
operator 1 keyspace 0x2c keys=2 key_bytes=64 value_bytes=5
operator 1 keyspace 0x1d keys=1 key_bytes=24 value_bytes=1
operator 2 keyspace 0x2c keys=1 key_bytes=32 value_bytes=1
count=3

# A delete removes the key from its bucket, and a bucket that empties drops out of the census entirely.

remove c ks=0x1D
flush
census
---
ok
operator 1 keyspace 0x2c keys=2 key_bytes=64 value_bytes=5
operator 2 keyspace 0x2c keys=1 key_bytes=32 value_bytes=1
count=2

# Dropping an operator empties every bucket it owns.

drop_state
flush
census
---
ok
operator 2 keyspace 0x2c keys=1 key_bytes=32 value_bytes=1
count=1
