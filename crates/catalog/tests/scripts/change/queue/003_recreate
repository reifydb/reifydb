# Create, drop, then recreate under the same name with different options: the
# replica must end up with the new id and the new partition count, not a merge
# of the two definitions.

admin 'CREATE NAMESPACE q'
admin 'CREATE QUEUE q::events { kind: utf8 } WITH { partitions: 2 }'
replicate
---
version: 2

query 'FROM system::queues FILTER {name == "events"}'
---
+---------+----------------+----------+--------------+--------------+
|   id    |  namespace_id  |   name   |  partitions  |  ordered_by  |
+---------+----------------+----------+--------------+--------------+
|  16385  |     16385      |  events  |      2       |     none     |
+---------+----------------+----------+--------------+--------------+

(admin 'DROP QUEUE q::events')
replicate
---
version: 3

query 'FROM system::queues FILTER {name == "events"}'
---
+------+----------------+--------+--------------+--------------+
|  id  |  namespace_id  |  name  |  partitions  |  ordered_by  |
+------+----------------+--------+--------------+--------------+
+------+----------------+--------+--------------+--------------+

admin 'CREATE QUEUE q::events { kind: utf8, payload: utf8 } WITH { partitions: 64, ordered_by: payload }'
replicate
---
version: 4

query 'FROM system::queues FILTER {name == "events"}'
---
+---------+----------------+----------+--------------+--------------+
|   id    |  namespace_id  |   name   |  partitions  |  ordered_by  |
+---------+----------------+----------+--------------+--------------+
|  16386  |     16385      |  events  |      64      |   payload    |
+---------+----------------+----------+--------------+--------------+
