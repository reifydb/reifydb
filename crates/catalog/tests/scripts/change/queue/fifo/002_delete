# Create queue, replicate, drop, replicate, verify the replica forgot it

admin 'CREATE NAMESPACE q'
admin 'CREATE QUEUE q::jobs { kind: utf8 } WITH { fifo: {} }'
replicate
---
version: 2

query 'FROM system::queue::queues FILTER {name == "jobs"}'
