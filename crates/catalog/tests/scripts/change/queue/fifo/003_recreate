# Create, drop, then recreate under the same name with different options: the
# replica must end up with the new id and the new partition count, not a merge
# of the two definitions.

admin 'CREATE NAMESPACE q'
admin 'CREATE QUEUE q::events { kind: utf8 } WITH { fifo: {} }'
replicate
---
version: 2

query 'FROM system::queues FILTER {name == "events"}'
